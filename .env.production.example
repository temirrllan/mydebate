# Шаблон окружения для развёртывания на своём сервере (docker-compose.yml).
# На сервере скопировать в .env рядом с docker-compose.yml и подставить значения:
#   cp .env.production.example .env
# Файл .env в git не попадает — в нём пароли.

# --- Домен -----------------------------------------------------------------
# Домен, на котором работает сайт. Должен уже указывать A-записью на IP этого
# сервера, иначе Caddy не выпустит сертификат. Без www и без https://.
DOMAIN="mydebate.kz"

# --- Postgres --------------------------------------------------------------
# Учётка базы внутри контейнера. Пароль — длинный и случайный, наружу база не
# торчит, но пароль всё равно должен быть нормальным:
#   openssl rand -base64 24
POSTGRES_USER="mydebate"
POSTGRES_PASSWORD=""
POSTGRES_DB="mydebate"

# Строка подключения для приложения. Хост — `db`, это имя сервиса из
# docker-compose.yml (внутри сети Docker он резолвится в контейнер базы).
# Логин/пароль/имя базы должны совпадать с тремя переменными выше.
# DIRECT_URL здесь не нужен: пулера между приложением и базой нет, миграции
# ходят по этой же строке (см. prisma.config.ts).
DATABASE_URL="postgresql://mydebate:ТОТ_ЖЕ_ПАРОЛЬ@db:5432/mydebate?schema=public"

# --- NextAuth --------------------------------------------------------------
# Ключ подписи сессий. Сгенерировать: openssl rand -base64 32
# Обязательно свой, отличный от локального: кто владеет ключом — может выписать
# себе сессию любого пользователя, включая администратора.
AUTH_SECRET=""

# Публичный адрес сайта — от него зависят OAuth-callback'и и ссылки в письмах.
AUTH_URL="https://mydebate.kz"

# Google OAuth: console.cloud.google.com -> Credentials.
# В Authorized redirect URIs добавить https://<домен>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Почта -----------------------------------------------------------------
# Письма сброса пароля и уведомления. Если не задать — приложение не падает,
# а пишет письмо в лог контейнера (видно через docker compose logs web).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="MyDebate <no-reply@mydebate.kz>"

# --- Хранилище файлов ------------------------------------------------------
# BLOB_READ_WRITE_TOKEN здесь НЕ задаём. Без него приложение пишет обложки в
# public/uploads/tournaments, а этот каталог смонтирован на постоянный том
# (см. docker-compose.yml) — то есть файлы лежат на диске сервера, как обычно.
