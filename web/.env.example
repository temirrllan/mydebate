# Шаблон переменных окружения. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# Сам .env в git не попадает (см. .gitignore) — секреты не коммитим.

# --- База данных -----------------------------------------------------------
# Строка подключения PostgreSQL, которую использует приложение в рантайме
# (lib/prisma.ts). На хостингах с пулером (Neon, Supabase) здесь должен быть
# ПУЛЕР: у serverless-инстансов Vercel их десятки, и прямые соединения быстро
# упрутся в лимит коннектов. Supabase — порт 6543 (pgbouncer), Neon — хост с
# суффиксом "-pooler".
DATABASE_URL="postgresql://user:password@localhost:5432/mydebate?schema=public"

# Прямое (не пулерное) соединение — только для CLI: `prisma migrate deploy`,
# `prisma db push`, seed (см. prisma.config.ts). Через pgbouncer в
# transaction-режиме миграции не проходят. Локально можно не задавать: тогда
# возьмётся DATABASE_URL.
# DIRECT_URL="postgresql://user:password@host:5432/mydebate?schema=public"

# --- NextAuth (Auth.js v5) -------------------------------------------------
# Ключ подписи JWT-сессий. Сгенерировать: openssl rand -base64 32
# На проде ОБЯЗАТЕЛЬНО свой, отличный от локального: утечка = возможность
# подписать сессию любого пользователя, включая админа.
AUTH_SECRET=""

# Публичный адрес приложения. От него зависят OAuth-callback'и и абсолютные
# ссылки в письмах (lib/email/templates.ts, lib/actions/auth.ts).
# Локально — http://localhost:3000, на проде — https://ваш-домен.
AUTH_URL="http://localhost:3000"

# Google OAuth: console.cloud.google.com -> APIs & Services -> Credentials.
# В Authorized redirect URIs добавьте <AUTH_URL>/api/auth/callback/google
# (отдельной строкой для локалки и для прод-домена), в Authorized JavaScript
# origins — сам AUTH_URL.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Почта (SMTP) ----------------------------------------------------------
# Используется для писем сброса пароля и уведомлений (lib/email/send.ts).
# Если SMTP_HOST/USER/PASSWORD не заданы — приложение не падает, а печатает
# письмо в консоль (удобно в разработке).
# Gmail: host smtp.gmail.com, port 465 (SSL) или 587 (STARTTLS), пароль — App
# Password из Google (16 символов, без пробелов), НЕ обычный пароль аккаунта.
# Для прода лучше транзакционный провайдер (Resend, Postmark): у Gmail лимит
# ~500 писем в сутки и письма чаще попадают в спам.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="MyDebate <no-reply@example.com>"

# --- Хранилище файлов ------------------------------------------------------
# Токен Vercel Blob для обложек/логотипов турниров
# (app/api/uploads/tournament-image/route.ts). На Vercel подставляется
# автоматически после подключения Blob-стора к проекту. Если переменной нет,
# файлы пишутся в public/uploads/tournaments — так и задумано для локальной
# разработки и self-hosted-развёртывания с постоянным диском, но НЕ для
# Vercel: там файловая система эфемерная и загруженные обложки пропадут.
# BLOB_READ_WRITE_TOKEN=""

# --- Тесты -----------------------------------------------------------------
# Отдельная БД для vitest (tests/global-setup.ts пересоздаёт её схему на каждом
# прогоне — НЕ указывайте сюда рабочую базу). По умолчанию mydebate_test.
# TEST_DATABASE_URL="postgresql://user@localhost:5432/mydebate_test?schema=public"
