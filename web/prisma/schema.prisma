// Prisma schema — MyDebate
// Этап 1: слой данных.
// Docs: https://pris.ly/d/prisma-schema
//
// БД: PostgreSQL (Supabase). Исторически проект начинался на SQLite, поэтому все
// "перечисления" ниже хранятся как String (а не нативный Prisma `enum`), а
// languages — строка через запятую (а не `String[]`). На Postgres это работает
// как есть; менять на нативные enum/массивы не стали ради минимального риска
// миграции. Допустимые значения задокументированы в комментариях к каждому полю
// и продублированы как TS-константы в `lib/enums.ts` (единый источник правды для кода).
//
// languages (Tournament.languages, User.languages) — список языков через запятую,
// без пробелов вокруг разделителя, например "Русский,English". Парсить на уровне
// приложения через lib/enums.ts (parseLanguages/formatLanguages).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// NextAuth (Этап 2) — стандартные модели @auth/prisma-adapter.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Восстановление пароля (не входит в стандартный adapter, но нужен для Credentials-флоу).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // nullable — для будущих OAuth-пользователей без пароля
  image         String? // аватар
  phone         String?
  city          String?
  school        String?
  major         String? // направление / специальность
  experience    String? // текстовое описание опыта
  bio           String?

  // level: BEGINNER | INTERMEDIATE | ADVANCED
  level String?

  // languages: список через запятую, например "Русский,English"
  languages String?

  // role: USER | ORGANIZER | ADMIN (Guest = неавторизован, не хранится в БД)
  role String @default("USER")

  isBlocked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  organizedTournaments Tournament[]         @relation("TournamentOrganizer")
  registrations        Registration[]
  favorites            Favorite[]
  notifications        Notification[]
  supportTickets       SupportTicket[]

  @@index([role])
  @@index([city])
}

// ---------------------------------------------------------------------------
// Tournament
// ---------------------------------------------------------------------------

model Tournament {
  id          String @id @default(cuid())
  title       String
  description String // Text

  // format: DEBATES | MUN
  format String

  // locationType: ONLINE | OFFLINE
  locationType String

  // level: BEGINNER | INTERMEDIATE | ADVANCED (nullable — не для всех турниров задан)
  level String?

  // languages: список через запятую, например "Русский,English"
  languages String

  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime

  price Int @default(0) // тенге

  city    String? // nullable для ONLINE
  address String?
  venue   String? // место проведения (здание/площадка)

  // status: DRAFT | PENDING | PUBLISHED | HIDDEN | DELETED
  status String @default("PENDING")

  coverImage String?
  logoImage  String?

  // registrationType: PLATFORM | EXTERNAL
  registrationType String  @default("PLATFORM")
  externalUrl      String?

  instagram String?
  telegram  String?
  email     String?

  rejectionReason String? // причина отклонения модерацией

  organizerId String
  organizer   User   @relation("TournamentOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      TournamentSection[]
  registrations Registration[]
  favorites     Favorite[]

  @@index([status])
  @@index([city])
  @@index([format])
  @@index([locationType])
  @@index([startDate])
  @@index([registrationDeadline])
  @@index([organizerId])
}

model TournamentSection {
  id           String @id @default(cuid())
  tournamentId String
  title        String
  description  String // Text
  order        Int    @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// ---------------------------------------------------------------------------
// Registration / Favorite
// ---------------------------------------------------------------------------

model Registration {
  id           String @id @default(cuid())
  userId       String
  tournamentId String

  // status: PENDING | ACCEPTED | CONFIRMED | WAITLIST
  status String @default("PENDING")

  // Данные простой формы регистрации (Этап 4, spec: без шага оплаты/чека —
  // по договорённости с заказчиком). Все поля ниже — снимок формы на момент
  // подачи заявки (не путать с профилем пользователя, который может
  // измениться позже). Заполняются в lib/actions/registrations.ts.
  fullName           String?
  gradeOrCourse      String?
  schoolOrUniversity String?
  phone              String?
  contactEmail       String?
  teamName           String?
  teammateNames      String?
  // experienceLevel: BEGINNER | INTERMEDIATE | ADVANCED (см. lib/enums.ts Level), опционально
  experienceLevel    String?
  preferredLanguage  String?
  additionalInfo     String?

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
  @@index([status])
}

model Favorite {
  id           String @id @default(cuid())
  userId       String
  tournamentId String

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
}

// ---------------------------------------------------------------------------
// Notification / SupportTicket
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String

  // type: TOURNAMENT_PUBLISHED | TOURNAMENT_REJECTED | NEW_REGISTRATION | DEADLINE_SOON | ... (nullable)
  type String?

  title   String
  message String // Text
  isRead  Boolean @default(false)
  link    String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model SupportTicket {
  id     String  @id @default(cuid())
  userId String? // nullable — по ТЗ обращается авторизованный, но оставляем гибкость

  name    String?
  email   String
  subject String
  message String // Text

  // status: OPEN | ANSWERED | CLOSED
  status String @default("OPEN")

  response String? // Text, ответ поддержки

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}
